{
  "name": "nexus-desktop",
  "productName": "NEXUS",
  "version": "1.2.1",
  "description": "NEXUS - The ultimate streaming desktop app",
  "author": "NEXUS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:win": "cross-env PLATFORM_OVERRIDE=win32 electron .",
    "start:mac": "cross-env PLATFORM_OVERRIDE=darwin electron .",
    "start:linux": "cross-env PLATFORM_OVERRIDE=linux electron .",
    "build": "npm run web:build && electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder --publish=never",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "vite",
    "web:build": "npx vite build && node scripts/fix-index-html.js",
    "electron:start": "electron .",
    "dev": "concurrently -k \"npm run web:dev\" \"npm run electron:start\""
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@types/chromecast-caf-sender": "^1.0.11",
    "@types/crypto-js": "^4.2.2",
    "@types/fscreen": "^1.0.4",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^20.19.23",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-stickynode": "^4.0.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^39.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "glob": "^10.4.5",
    "globals": "^17.1.0",
    "handlebars": "^4.7.8",
    "jsdom": "^23.2.0",
    "postcss": "^8.5.6",
    "postcss-rtl": "^2.0.0",
    "postcss-rtlcss": "^4.0.9",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.34.5",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-themer": "^4.1.1",
    "to-ico": "^1.1.5",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-pwa": "^0.17.5",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^1.6.1",
    "workbox-window": "^7.3.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "^0.8.4",
    "@headlessui/react": "^1.7.19",
    "@ladjs/country-language": "^1.0.3",
    "@marsidev/react-turnstile": "^0.7.2",
    "@noble/hashes": "^1.8.0",
    "@plasmohq/messaging": "^0.6.2",
    "@react-spring/web": "^9.7.5",
    "@scure/bip39": "^1.6.0",
    "@sozialhelden/ietf-language-tags": "^5.4.2",
    "@types/node-forge": "^1.3.14",
    "cheerio": "^1.0.0-rc.12",
    "classnames": "^2.5.1",
    "core-js": "^3.46.0",
    "detect-browser": "^5.3.0",
    "dompurify": "^3.3.0",
    "electron-updater": "^6.7.3",
    "flag-icons": "^7.5.0",
    "focus-trap-react": "^10.3.1",
    "framer-motion": "^12.27.1",
    "fscreen": "^1.2.0",
    "fuse.js": "^7.1.0",
    "hls.js": "^1.6.13",
    "i18next": "^23.16.8",
    "immer": "^10.1.3",
    "iso-639-3": "^3.0.1",
    "jwt-decode": "^4.0.0",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "node-forge": "^1.3.1",
    "ofetch": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^14.1.3",
    "react-lazy-with-preload": "^2.2.1",
    "react-router-dom": "^6.30.1",
    "react-sticky-el": "^2.1.1",
    "react-use": "^17.6.0",
    "semver": "^7.7.3",
    "slugify": "^1.6.6",
    "subsrt-ts": "^2.1.2",
    "wyzie-lib": "^2.2.6",
    "zustand": "^4.5.7"
  },
  "build": {
    "appId": "com.nexus.desktop",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "ZETICUZ",
      "repo": "NEXUS-desktop"
    },
    "files": [
      "dist-web/**/*",
      "public/**/*",
      "main.js",
      "preload.js",
      "renderer.js",
      "package.json",
      "ipc-handlers.js",
      "storage.js",
      "auto-updater.js",
      "preload-titlebar.js",
      "preload-control-panel.js",
      "preload-updater.js",
      "renderer.css",
      "control-panel.html",
      "control-panel.css",
      "control-panel.js",
      "titlebar.html",
      "updater.html",
      "updater.css",
      "updater.js"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "public/nexus-logo.png",
      "target": [
        "dmg",
        "zip"
      ],
      "strictVerify": false
    },
    "win": {
      "icon": "public/nexus-icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker",
      "executableName": "NEXUS",
      "signAndEditExecutable": false
    },
    "linux": {
      "icon": "public/nexus-logo.png",
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "runAfterFinish": true,
      "language": "1033",
      "allowElevation": false,
      "warningsAsErrors": false,
      "differentialPackage": false,
      "multiLanguageInstaller": false,
      "packElevateHelper": false,
      "installerIcon": null,
      "uninstallerIcon": null
    }
  }
}
